# Ansible renders this template during the pipeline.
apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata:
  name: {{ app_name }}-deployer
  namespace: {{ namespace }}
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: ClusterRole
  # cluster-admin is a demo-level simplification; see README Security section.
  name: cluster-admin
subjects:
  - kind: ServiceAccount
    name: default
    namespace: {{ namespace }}
